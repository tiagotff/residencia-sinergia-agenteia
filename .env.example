# Provedor de LLM: "groq" ou "none" (sem LLM: mensagens e extração usam regras fixas)
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.2
GROQ_API_KEY=coloque-sua-chave-aqui

# Verificação do CRM (regra R06):
#   cfm   = webservice oficial do CFM (exige CFM_ACCESS_KEY, emitida para a instituição)
#   local = registro fictício em CRM_REGISTRY_PATH (validação local e testes)
#   none  = sem verificação automática: todo caso vai para revisão humana
CRM_VERIFIER=local
CRM_REGISTRY_PATH=config/crm_registry.yaml
CFM_ACCESS_KEY=

# Pasta local para banco, checkpoints e arquivos recebidos
DATA_DIR=data
RULES_PATH=config/rules.yaml
TIMEZONE=America/Sao_Paulo
