# Provedor de LLM: "groq" ou "none" (sem LLM: mensagens usam modelos de texto fixos)
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.2
GROQ_API_KEY=coloque-sua-chave-aqui

# Pasta local para banco, checkpoints e arquivos recebidos
DATA_DIR=data
RULES_PATH=config/rules.yaml
TIMEZONE=America/Sao_Paulo
